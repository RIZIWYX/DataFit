# Copier ce fichier en .env et mettre vos propres valeurs (.env n'est jamais commité)
DB_USER=datafit_user
DB_PASSWORD=change-moi

# Paiement Stripe en mode test (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY=sk_test_...
# donné par "stripe listen" (Stripe CLI) en local
STRIPE_WEBHOOK_SECRET=whsec_...
# identifiants des deux prix du produit Premium (Catalogue de produits)
STRIPE_PRIX_MENSUEL=price_...
STRIPE_PRIX_ANNUEL=price_...
# adresse du site pour le retour après paiement (http://localhost:3000 avec Docker)
SITE_URL=http://localhost:5173

# --- Sécurité (les valeurs par défaut conviennent en local) ---
# Sites autorisés à appeler l'API (CORS), séparés par des virgules. À changer pour un autre domaine.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# En ligne (HTTPS) : mettre true, pour que le cookie de session ne circule jamais en clair
# SESSION_COOKIE_SECURISE=false
# Requêtes SQL dans les logs du backend (peuvent contenir des données de santé : à n'activer que pour déboguer)
# JPA_SHOW_SQL=false
# Pages /docs des services Python (simulateur et analyse) : éteintes par défaut, 1 pour les allumer
# DOCS_ACTIVES=
