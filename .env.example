# Copier ce fichier en .env et mettre vos propres valeurs (.env n'est jamais commité)
DB_USER=datafit_user
DB_PASSWORD=change-moi

# Mails de confirmation de l'adresse, envoyés avec Resend (resend.com → API Keys).
# Laissée vide : aucun mail ne part, le lien de confirmation s'affiche dans les logs du backend.
RESEND_API_KEY=
# onboarding@resend.dev n'écrit qu'à l'adresse de votre compte Resend : pour écrire à tout le
# monde, vérifiez un domaine chez Resend (page Domains) et mettez une adresse de ce domaine
MAIL_EXPEDITEUR="DataFit <onboarding@resend.dev>"
# l'adresse du site, utilisée dans le lien du mail (http://localhost:5173 avec Vite)
APP_URL=http://localhost:3000
