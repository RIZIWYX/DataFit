# Copier ce fichier en .env et mettre vos propres valeurs (.env n'est jamais commité)
DB_USER=datafit_user
DB_PASSWORD=change-moi

# Paiement Stripe en mode test (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY=sk_test_...
# donné par "stripe listen" (Stripe CLI) en local
STRIPE_WEBHOOK_SECRET=whsec_...
# identifiants des deux prix du produit Premium (Catalogue de produits)
STRIPE_PRIX_MENSUEL=price_...
STRIPE_PRIX_ANNUEL=price_...
# adresse du site pour le retour après paiement (http://localhost:3000 avec Docker)
SITE_URL=http://localhost:5173
